#!/bin/sh
# 显影泄露门 · pre-push — 最后一道物理闸
# 出境引用的【全部历史】（每个提交的正文与 diff）逐行扫描；private/* 分支永禁外推。
PAT="[0-9]{9,}|auto""journey|私有""风格矩阵|private[-_ ]style[-_ ]matrix"
blocked=0
while read local_ref local_sha remote_ref remote_sha; do
  case "$local_ref" in
    refs/heads/private/*)
      echo "[GUARD] BLOCKED pre-push: $local_ref is a private branch and must never be pushed"
      blocked=1
      continue
      ;;
  esac
  # 全零 sha = 删除远端分支，放行
  if [ -z "$(printf %s "$local_sha" | tr -d 0)" ]; then
    continue
  fi
  if git log -p --format='%B' "$local_sha" | grep -qiE "$PAT"; then
    echo "[GUARD] BLOCKED pre-push: full history of $local_ref matches leak pattern"
    blocked=1
  fi
done
exit $blocked
